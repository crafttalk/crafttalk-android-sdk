#!/usr/bin/env bash
set -euo pipefail

root=$(git rev-parse --show-toplevel)
checked=" "
while read -r local_ref local_oid remote_ref remote_oid; do
    [[ $local_oid =~ ^0+$ ]] && continue
    case "$remote_ref" in
        refs/heads/*) ;;
        refs/tags/*)
            target_type=$(git cat-file -t "$local_oid^{}")
            [[ $target_type == commit ]] || continue
            ;;
        *) continue ;;
    esac
    commit=$(git rev-parse --verify "$local_oid^{commit}")
    [[ $checked == *" $commit "* ]] && continue

    (
        snapshot=$(mktemp -d "${TMPDIR:-/tmp}/crafttalk-android.XXXXXX")
        trap 'rm -rf -- "$snapshot"' EXIT
        git archive "$commit" | tar -x -C "$snapshot"
        if [[ -f "$root/local.properties" ]]; then
            cp "$root/local.properties" "$snapshot/local.properties"
        fi

        cd "$snapshot"
        echo "Android-тесты $local_ref ($commit). Gradle автоматически запустит тестовый эмулятор API 32." >&2
        if ./gradlew --init-script "$root/.githooks/android-test-device.gradle" --max-workers=1 \
            :chat:prePushApi32DebugAndroidTest --rerun :app:prePushApi32DebugAndroidTest --rerun </dev/null; then
            exit 0
        else
            status=$?
        fi

        reports="$root/build/reports/pre-push/$commit"
        mkdir -p "$reports"
        attempt=$(mktemp -d "$reports/attempt.XXXXXX")
        for module in chat app; do
            report="$module/build/reports/androidTests/managedDevice/debug/prePushApi32"
            [[ -f "$report/index.html" ]] || continue
            cp -R "$report" "$attempt/$module"
            echo "Отчёт $module: $attempt/$module/index.html" >&2
        done
        exit "$status"
    )
    checked+="$commit "
done
